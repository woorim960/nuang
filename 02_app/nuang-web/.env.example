# 로컬 개발에서는 아래 주소를 사용합니다.
# Vercel Production에서는 반드시 공식 HTTPS 주소로 별도 설정합니다.
# 예: https://nuang-five.vercel.app
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000


# 브라우저에 노출되어도 되는 Supabase 공개 설정값입니다.
# 단, 실제 프로젝트 값은 보안상 채팅이나 캡처 화면에 노출하지 않는 것이 좋습니다.

# Supabase 프로젝트 URL입니다.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명 공개 키입니다.
# 클라이언트에서 Supabase에 접근할 때 사용됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# 서버에서만 사용해야 하는 값입니다.
# 절대 브라우저 코드, 프론트엔드 화면, 스크린샷에 노출하면 안 됩니다.

# Supabase 관리자 권한 키입니다.
# 데이터베이스에 강한 권한으로 접근할 수 있으므로 절대 외부에 노출하면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 데이터베이스 직접 연결 주소입니다.
# 서버에서 DB에 연결할 때 사용합니다.
DATABASE_URL=


# Google 및 Kakao OAuth 로그인 정보는 Supabase 대시보드에서 설정합니다.
# 카카오톡 공식 공유에는 Kakao Developers의 공개 JavaScript 키를 별도로 입력합니다.
# NEXT_PUBLIC_* 값은 빌드 시점에 반영되므로 변경 후 반드시 재빌드·재배포합니다.
# Kakao JS SDK 도메인에 로컬과 운영 origin을 모두 등록해야 합니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Naver 로그인은 Supabase 기본 OAuth만으로 바로 처리하기 어렵습니다.
# 별도의 OAuth/OIDC 브릿지 또는 직접 구현한 콜백 처리가 필요합니다.

# Naver OAuth 클라이언트 ID입니다.
NAVER_OAUTH_CLIENT_ID=

# Naver OAuth 클라이언트 시크릿입니다.
# 서버에서만 사용해야 하며 외부에 노출하면 안 됩니다.
NAVER_OAUTH_CLIENT_SECRET=


# 향후 공유 토큰 생성 및 연락처 필드 암호화에 사용할 서버 전용 비밀값입니다.

# 공유 링크나 초대 토큰을 더 안전하게 만들기 위한 추가 비밀값입니다.
SHARE_TOKEN_PEPPER=

# 연락처 같은 민감한 필드를 암호화할 때 사용할 키입니다.
FIELD_ENCRYPTION_KEY=

# 최초 관리자 계정으로 등록할 이메일 목록입니다.
# 여러 명이면 쉼표로 구분해서 입력할 수 있습니다.
ADMIN_BOOTSTRAP_EMAILS=

# 새 의견·신고·링크 검토 알림을 받을 운영자 이메일 목록입니다.
# 여러 명이면 쉼표로 구분합니다. 비워 두면 ADMIN_BOOTSTRAP_EMAILS를 사용합니다.
ADMIN_REVIEW_NOTIFICATION_EMAILS=

# 비공개 프로필 이메일 인증번호를 발송하는 Resend 서버 키입니다.
# Resend 무료 플랜으로 시작할 수 있으며 브라우저 코드에 노출하면 안 됩니다.
RESEND_API_KEY=

# Resend에서 인증을 마친 전송 도메인의 발신 주소입니다.
# 예: NUANG <verify@notice.example.com>
EMAIL_VERIFICATION_FROM=

# 운영 알림 전용 발신 주소입니다. 비워 두면 EMAIL_VERIFICATION_FROM을 사용합니다.
ADMIN_NOTIFICATION_FROM=

# 광고·제휴 문의 알림을 받을 운영 이메일 목록입니다.
# 여러 명이면 쉼표로 구분합니다. 비워 두면 ADMIN_REVIEW_NOTIFICATION_EMAILS,
# 그마저 비어 있으면 ADMIN_BOOTSTRAP_EMAILS를 사용합니다.
AD_INQUIRY_NOTIFICATION_EMAILS=

# 광고·제휴 문의 접수 확인 메일의 발신 주소입니다.
# 예: NUANG Business <business@notice.example.com>
# 비워 두면 ADMIN_NOTIFICATION_FROM 또는 EMAIL_VERIFICATION_FROM을 사용합니다.
AD_INQUIRY_FROM=

# 광고 문의 이메일·요청 지문·중복 키의 blind index에만 사용하는 서버 비밀값입니다.
# SHARE_TOKEN_PEPPER와 다른 충분히 긴 무작위 값을 사용합니다.
AD_CONTACT_HASH_PEPPER=

# 광고 노출·의견의 30분 익명 세션을 HMAC 처리하는 전용 비밀값입니다.
# 연락처 hash pepper와 다른 충분히 긴 무작위 값을 사용합니다.
AD_EVENT_SESSION_PEPPER=

# 광고 문의 메일 outbox 예약 작업을 보호하는 서버 비밀값입니다.
# 브라우저 코드에 넣지 말고 Vercel Cron Authorization에만 사용합니다.
AD_OUTBOX_CRON_SECRET=

# Resend의 광고 문의 webhook signing secret입니다. whsec_로 시작하는 값을 사용합니다.
AD_RESEND_WEBHOOK_SECRET=

# 회원 광고성 이메일 Release 1입니다. 모든 준비와 테스트가 끝나기 전까지 false로 둡니다.
MARKETING_EMAIL_SEND_ENABLED=false
MARKETING_EMAIL_FROM="뉴앙 <news@notice.nuang.app>"
MARKETING_EMAIL_REPLY_TO=woorimprog@gmail.com
MARKETING_CONTACT_EMAIL=woorimprog@gmail.com
MARKETING_CONTACT_PHONE=010-2515-0939


# 광고 송출은 아래 스위치, 공급자 준비 상태, 운영센터 인벤토리와
# 긴급 중지 스위치가 모두 허용된 경우에만 작동합니다. 초기값은 false입니다.
ADVERTISING_ENABLED=false

# Google AdSense 수동 반응형 홈 광고입니다.
ADSENSE_ENABLED=false
ADSENSE_SITE_READY=false
ADSENSE_PRIVACY_READY=false
ADSENSE_CSP_REPORT_ONLY_READY=false
ADSENSE_EEA_CMP_READY=false
# AdSense 화면의 ca-pub-... 또는 pub-... 값을 입력합니다.
ADSENSE_PUBLISHER_ID=
# HOME_INLINE_01용 수동 디스플레이 광고 단위의 숫자 슬롯 ID입니다.
ADSENSE_HOME_SLOT_ID=

# 쿠팡 파트너스 정적 제휴 카드입니다.
COUPANG_PARTNERS_ENABLED=false
COUPANG_POLICY_READY=false
# 쉼표로 구분한 정확한 HTTPS hostname만 입력합니다. 와일드카드는 사용하지 않습니다.
# 예: link.coupang.com,www.coupang.com
COUPANG_ALLOWED_DESTINATION_HOSTS=
# 쿠팡에서 승인받은 정적 이미지 hostname 목록입니다.
COUPANG_ALLOWED_IMAGE_HOSTS=

# 약관과 개인정보 처리방침에 표시할 실제 서비스 운영자 정보입니다.
# 출시 전에 실제 운영 주체의 정확한 이름으로 입력해야 합니다.
LEGAL_OPERATOR_NAME=
LEGAL_BUSINESS_NAME=딱좋은라이프
LEGAL_REPRESENTATIVE_NAME=박우림
LEGAL_BUSINESS_REGISTRATION_NUMBER=768-75-00424
LEGAL_SERVICE_ORIGIN=https://nuang.app
# 예: 접수 후 1~3일 이내
LEGAL_SUPPORT_RESPONSE_WINDOW=접수 후 1~3일 이내

# 개인정보 문의를 받을 운영 이메일입니다.
PRIVACY_CONTACT_EMAIL=

# Supabase 프로젝트가 실제로 선택한 데이터 저장 리전입니다.
# 예: Seoul (ap-northeast-2). 대시보드의 프로젝트 리전과 동일하게 입력합니다.
SUPABASE_DATA_REGION=


# Gate C 검사 질문 리뷰 이벤트 운영값입니다.
# 시작일 없이 MVP 공개 시점부터 자동으로 열립니다.
# 긴급하게 응모를 중단해야 할 때만 false로 설정합니다.
GATE_C_REVIEW_EVENT_ENTRY_ENABLED=true

# 시작일은 두지 않습니다. MVP 공개 시점부터 2026년 9월 30일까지 진행하고,
# 2026년 10월 1일 추첨·발표하고 이벤트 응모 기록은 2026년 11월 1일 삭제합니다.
# 휴대전화번호는 회원의 비공개 프로필 정보로 보관하며 사용자가 직접 변경·삭제합니다.
# 연락 방식은 휴대전화이며 회원 계정·휴대전화번호별로 한 번만 응모할 수 있습니다.

# 실제 추첨 시각 전 localhost에서 운영 화면을 검증할 때만 true로 사용합니다.
GATE_C_REWARD_DRAW_PREVIEW_ENABLED=false
