name = "nuang-feed-media"
main = "src/index.ts"
compatibility_date = "2026-08-15"
workers_dev = false

# Keep the bucket private. Do not enable r2.dev or attach an R2 custom domain.
[[r2_buckets]]
binding = "FEED_MEDIA"
bucket_name = "nuang-feed-media"

[[routes]]
pattern = "media.nuang.app"
custom_domain = true

# Set the same 32+ character secret used by the Next.js server with:
# npx wrangler secret put FEED_MEDIA_R2_DELIVERY_SIGNING_SECRET
# Never put the secret or a Cloudflare account identifier in this file.
