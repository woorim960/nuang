  "reviewRules": [
    "문장에 축 관련 단어가 있다는 이유만으로 축을 배정하지 않는다.",
    "두 원문에서 실제 주의·생각·반응·말하기의 방향이 대비될 때만 최소 축을 배정한다.",
    "핵심 행동은 같고 구체성이나 예시만 다르면 축 없음과 공통 문장 병합으로 결정한다.",
    "두 축이 모두 없으면 차이를 설명할 수 없을 때만 복합축 후보로 남긴다.",
    "이 판독은 연구용 재합성 후보이며 고객 발행 승인이 아니다."
  ],
  "rationaleCatalog": {
    "WORDING_ONLY_MERGE": "핵심 행동 방향은 같고 예시·문장 순서·구체성만 달라 공통 문장으로 병합한다.",
    "SE_CONTRAST": "혼자 정리하는 흐름과 대화·공동 활동으로 풀어가는 흐름의 차이가 핵심이다.",
    "OE_CONTRAST": "확인 가능한 사실·경험과 가능성·의미·여러 해석을 살피는 차이가 핵심이다.",
    "RO_CONTRAST": "원인·해결·행동 기준과 마음·관계·공감에 주의를 두는 차이가 핵심이다.",
    "SM_CONTRAST": "정해진 순서·계획·마무리와 상황에 맞춘 조정·유연한 실행의 차이가 핵심이다.",
    "ER_CONTRAST": "걱정·긴장·빠른 신호 감지와 차분히 시간을 두고 반응하는 차이가 핵심이다.",
    "SE_RO_INTERACTION": "표현을 안팎으로 여는 방식과 관계에서 무엇을 먼저 살피는 방식이 함께 문장을 바꾼다.",
    "SE_OE_INTERACTION": "대화로 확장하는 방식과 사실·가능성을 탐색하는 방식이 함께 문장을 바꾼다.",
    "OE_RO_INTERACTION": "사실·가능성 탐색과 문제·마음의 관계 초점이 함께 문장을 바꾼다.",
    "OE_ER_INTERACTION": "사실·여러 해석을 구분하는 방식과 불확실성에 대한 걱정 반응이 함께 문장을 바꾼다.",
    "RO_ER_INTERACTION": "관계에서 살피는 초점과 상처·거리 변화에 대한 걱정 반응이 함께 문장을 바꾼다.",
    "SM_ER_INTERACTION": "실행을 정리하는 방식과 감정이 가라앉고 회복되는 조건이 함께 문장을 바꾼다."
  },
