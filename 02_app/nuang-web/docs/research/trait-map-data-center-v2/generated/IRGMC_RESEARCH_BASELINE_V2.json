  "chapterResearchQuestions": [
    {
      "chapterId": "overview",
      "question": "다섯 방향이 함께 나타날 때 가장 먼저 보이는 핵심 모습은 무엇인가?"
    },
    {
      "chapterId": "role_name_and_values",
      "question": "‘단서로 답을 찾는 탐구자’라는 이름이 어떤 행동을 설명하고 어떤 오해를 만드는가?"
    },
    {
      "chapterId": "five_code_positions",
      "question": "I·R·G·M·C 각 방향과 세부 성향은 어떻게 구분되는가?"
    },
    {
      "chapterId": "code_interactions",
      "question": "다섯 방향의 조합이 단일 방향 설명을 넘어서는 증분 정보를 주는가?"
    },
    {
      "chapterId": "first_thought_and_actual_response",
      "question": "원인·해결을 먼저 생각해도 실제로는 어떻게 말하고 행동하는가?"
    },
    {
      "chapterId": "daily_choice_and_change",
      "question": "평소 선택·새 만남·계획 변화에서 무엇을 먼저 확인하는가?"
    },
    {
      "chapterId": "family",
      "question": "가족 역할과 의무를 걷어냈을 때 반복되는 생각과 행동은 무엇인가?"
    },
    {
      "chapterId": "friend",
      "question": "친구의 친숙도와 모임 크기에 따라 참여·연락·지원이 어떻게 달라지는가?"
    },
    {
      "chapterId": "partner",
      "question": "연인과의 갈등·지원·회복에서 원인 탐색과 감정 확인의 순서는 어떠한가?"
    },
    {
      "chapterId": "person_of_interest",
      "question": "호감과 불확실성이 생겨도 사실과 추측을 어떻게 구분하는가?"
    },
    {
      "chapterId": "work_and_study",
      "question": "규칙·재량·마감·자원이 실행 방식과 의견 표현을 어떻게 바꾸는가?"
    },
    {
      "chapterId": "conflict_stress_and_recovery",
      "question": "감정이 천천히 커지는 것과 회복 속도·방법은 어떻게 다른가?"
    },
    {
      "chapterId": "strength_overuse_and_growth",
      "question": "구체성·차분함·상황 적응이 도움이 되는 조건과 과해지는 조건은 무엇인가?"
    },
    {
      "chapterId": "misunderstanding_and_communication",
      "question": "무관심·수동성·창의성 부족으로 오해받지 않도록 무엇을 보여줘야 하는가?"
    },
    {
      "chapterId": "neighbor_contrasts",
      "question": "한 글자만 다른 5개 코드와 어떤 장면에서 가장 분명히 구분되는가?"
    },
    {
      "chapterId": "evidence_and_method",
      "question": "어떤 근거와 뉴앙 자료가 각 문장을 승인하거나 기각하는가?"
    }
  ],
